{
  "name": "portal-reestruturacao-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do portal de decisoes de reestruturacao",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/db/esquema.sql dist/db/esquema.sql",
    "start": "node dist/index.js",
    "migrar": "tsx src/db/migrar.ts",
    "semear": "tsx src/db/semear.ts",
    "criar-admin": "tsx src/scripts/criar-admin.ts",
    "test": "tsx --test test/*.test.ts",
    "semear-demo": "tsx src/db/semear-demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}