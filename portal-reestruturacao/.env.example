# Copie para .env e ajuste antes de subir. Nunca versione o .env preenchido.

# Banco de dados (interno ao compose; não é exposto na rede)
POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=portal

# Porta em que o portal ficará disponível no servidor interno
PORTA_PUBLICA=8080

# true quando o portal for publicado por HTTPS (obrigatório em produção)
COOKIE_SECURE=false

# Duração da sessão (horas) e limite de upload da planilha (MB)
SESSION_HOURS=8
MAX_UPLOAD_MB=25
