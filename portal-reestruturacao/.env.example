# Copie para .env e ajuste antes de subir. Nunca versione o .env preenchido.

# Banco de dados (interno ao compose; não é exposto na rede)
POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=portal

# Porta em que o portal ficará disponível no servidor interno
PORTA_PUBLICA=8080

# true quando o portal for publicado por HTTPS (obrigatório em produção)
COOKIE_SECURE=false

# Duração da sessão (horas) e limite de upload da planilha (MB)
SESSION_HOURS=8
MAX_UPLOAD_MB=25

# --- hospedagem fora da empresa (ver IMPLANTACAO-NUVEM.md) ---
# Faixas de IP autorizadas (rede da empresa / VPN). Vazio = qualquer origem acessa.
# Exemplo: IPS_PERMITIDOS=200.150.10.0/24, 187.44.7.9
IPS_PERMITIDOS=

# TLS na conexão com o banco (obrigatório em Supabase/Neon; dispensável no banco interno)
DB_SSL=false

# Administrador criado na primeira subida, para quem implanta sem terminal.
# A senha é provisória: o portal exige a troca no primeiro acesso.
ADMIN_USUARIO=rh.admin
ADMIN_NOME=
ADMIN_SENHA=
