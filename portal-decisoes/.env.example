# Copie para .env e ajuste. Nunca versione o .env preenchido.

# Porta e interface de escuta.
# 0.0.0.0 publica na rede interna; use 127.0.0.1 se houver proxy reverso no mesmo servidor.
PORT=3000
HOST=0.0.0.0

# Caminho do banco SQLite (faça backup deste arquivo).
DB_PATH=./dados/portal.db

# true quando o portal for servido por HTTPS (obrigatório em produção).
COOKIE_SECURE=false

# Duração da sessão, em horas.
SESSION_HOURS=8

# Limite de upload da planilha, em MB.
MAX_UPLOAD_MB=20

# Bloqueio de login por tentativas erradas.
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=15
