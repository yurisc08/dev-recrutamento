# /etc/systemd/system/portal-decisoes.service
# sudo systemctl daemon-reload && sudo systemctl enable --now portal-decisoes
[Unit]
Description=Portal de Decisoes - Reestruturacao
After=network.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/portal-decisoes
EnvironmentFile=/opt/portal-decisoes/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Endurecimento basico do servico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/portal-decisoes/dados
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
